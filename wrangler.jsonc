// Cloudflare Workers Builds runs `npx wrangler deploy` from the repo root.
// Serves the static site in ./site, and /api/* (Evade icons in the tab list) from worker/index.js.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "evade-client",
  "main": "worker/index.js",
  "compatibility_date": "2025-06-01",
  "assets": {
    "directory": "./site",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*"]
  },
  // One SQLite-backed Durable Object holds icon state; Cloudflare creates it on deploy (free plan supports it).
  "durable_objects": { "bindings": [{ "name": "ICONS", "class_name": "EvadeIcons" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["EvadeIcons"] }]
  // Optional secret for granting supporter icons: npx wrangler secret put ADMIN_TOKEN
}
