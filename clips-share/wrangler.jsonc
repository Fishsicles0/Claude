// Evade Clips Share: instant share links and phone sync for Evade Clips.
// Deploy your own with `npx wrangler deploy` (after `npx wrangler r2 bucket create evade-clips`).
{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "evade-clips-share",
  "main": "src/index.js",
  "compatibility_date": "2025-06-01",
  "r2_buckets": [{ "binding": "CLIPS", "bucket_name": "evade-clips" }],
  "vars": {
    // Storage per account, in GB.
    "QUOTA_GB": "25",
    // Set a REGISTER_SECRET secret (`npx wrangler secret put REGISTER_SECRET`) to make the service private:
    // only apps that know it can create accounts. Without it, anyone can register.
    "SITE_NAME": "Evade Clips"
  }
}
